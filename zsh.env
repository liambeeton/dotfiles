# Shared Zsh configuration, sourced by ~/.zshrc (see setup_zsh in setup.sh).
# Put machine-specific settings in ~/.zshrc; it is not tracked by this repo.

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# zsh-autosuggestions reads these when Oh My Zsh loads it
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(
  git
  kubectl
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# load zsh completions plugin
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

source $ZSH/oh-my-zsh.sh

# get machine's ip address
alias ip="ipconfig getifaddr en0"

# edit global zsh configuration
alias zshconfig="code ~/.dotfiles/zsh.env"
# reload zsh configuration
alias zshsource="source ~/.zshrc"
# navigate to oh-my-zsh
alias ohmyzsh="cd ~/.oh-my-zsh"

# navigate to global ssh directory
alias sshhome="cd ~/.ssh"
# edit global ssh configuration
alias sshconfig="code ~/.ssh/config"

# edit global git configuration
alias gitconfig="code ~/.gitconfig"

# custom aliases
alias dev="cd ~/Developer"
alias dot="cd ~/.dotfiles"
alias era=": > ~/.zsh_history && rm ~/.zsh_history && rm -f ~/.local/share/atuin/history.db*"
alias pip="pip3"

# git aliases
alias gits="git status"
alias gitd="git diff"
alias gitl="git lg"
alias gita="git add ."
alias gitc="cz commit"
alias gitf='git commit --fixup $(git log -1 --format=%H)'
alias gitn='git branch | grep -v "develop" | grep -v "master" | grep -v "main" | xargs git branch -D'

# docker aliases
alias docp="docker ps -a"
alias docu="docker-compose up --build"
alias docb="docker-compose build"
alias docd="docker-compose down -v"
alias docs='docker stop $(docker ps -a -q)'
alias docr='docker rm $(docker ps -a -q)'

# hosts config
alias hostsconfig="sudo nano /etc/hosts"

# count lines of code
alias loc="tokei"

# modern replacements (some ls flags differ, e.g. -t; use "command ls" for the original)
alias ls="eza --icons --group-directories-first"
alias ll="eza -l --icons --group-directories-first"
alias la="eza -la --icons --group-directories-first"
alias lt="eza --tree --level=2 --icons"
alias cat="bat --style=auto --paging=never"

# set by brew shellenv in ~/.zprofile, which non-login shells do not read
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# use dotnet
export DOTNET_ROOT="$HOMEBREW_PREFIX/opt/dotnet/libexec"
export PATH="$PATH:$HOME/.dotnet/tools"

# use android
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="$ANDROID_HOME/tools:$PATH"
export PATH="$ANDROID_HOME/tools/bin:$PATH"

# use golang
export GOPATH="$HOME/go"
export GOROOT="$HOMEBREW_PREFIX/opt/go/libexec"
export PATH="$PATH:$GOPATH/bin"
export PATH="$PATH:$GOROOT/bin"

# use jenv
export PATH="$HOME/.jenv/bin:$PATH"
export PATH="$HOME/.jenv/shims:$PATH"
eval "$(jenv init -)"

# use mise (node and global npm packages, see mise/config.toml)
eval "$(mise activate zsh)"

# use rust
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# use pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# use direnv
eval "$(direnv hook zsh)"

# use fzf
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --icons --color=always --tree --level=2 {}'"
source <(fzf --zsh)

# use atuin for ctrl-r (needs to come after fzf, which also binds it)
eval "$(atuin init zsh --disable-up-arrow)"

# use zoxide (z and zi commands)
eval "$(zoxide init zsh)"

# use starship theme (needs to be at the end)
eval "$(starship init zsh)"
