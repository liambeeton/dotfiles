# Handle line endings automatically for files detected as text
# and perform LF normalization (strips CR on commit)
* text=auto

# Explicitly declare text files you want to always be normalized and
# converted to native line endings on checkout
*.txt text
*.html text
*.css text
*.js text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Set line endings to LF for shell scripts so they work on Unix-like systems
*.sh text eol=lf

# Set line endings to CRLF for Windows-specific batch files
*.bat text eol=crlf
