[user]
	name = Liam Beeton
	email = liam.beeton@gmail.com
	useConfigOnly = true

[init]
	defaultBranch = main

[core]
	editor = code --wait
	pager = delta
	autocrlf = input
	safecrlf = warn
	precomposeUnicode = true
  attributesfile = ~/.global_gitattributes
  excludesfile = ~/.global_gitignore

[color]
	ui = auto

[credential]
	helper = osxkeychain

[fetch]
	prune = true
  pruneTags = true

[pull]
	rebase = true
	ff = only

[push]
	default = simple
	autoSetupRemote = true
  followTags = true

[merge]
  tool = vscode
	conflictStyle = zdiff3

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "vscode"]
  cmd = code --wait --merge $LOCAL $REMOTE $BASE $MERGED
  trustExitCode = true

[rebase]
	autoSquash = true
	autoStash = true

[rerere]
	enabled = true
  autoupdate = true

[diff]
  tool = vscode
	algorithm = histogram
	colorMoved = zebra

[difftool]
  prompt = false

[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE

[status]
	short = true
	branch = true

[alias]
  a = add
  aa = add -A
	st = status -sb
  co = checkout
  cob = checkout -b
  br = branch
  brv = branch -vv
  ci = commit
  reword = commit --amend -m
  amend = commit --amend --no-edit
  unstage = restore --staged
  discard = restore
  last = log -1 --stat
  lh = log -1 --format=%H
	lg = log --oneline --graph --decorate --all
  lp = log --graph --decorate --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %C(green)%an%Creset %C(auto)%d%Creset %s' --date=short --all
  df = diff
  dc = diff --cached
  pl = pull
  ps = push
  rb = rebase
  sw = switch
  swc = switch -c
  pf = push --force
  aliases = config --get-regexp ^alias
  cleanup-merged = !git branch --merged | grep -v '\\*' | grep -v 'main' | xargs -n 1 git branch -d
  fixup = "!f() { TARGET=$(git rev-parse $1); git commit --fixup=$TARGET ${@:2} && GIT_SEQUENCE_EDITOR=true git rebase -i --autostash --autosquash $TARGET^; }; f"

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
  side-by-side = true
  line-numbers = true

[commit]
  verbose = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[help]
  autocorrect = prompt

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
