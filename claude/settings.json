{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(brew list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude needs your input\"' | { read -r m; osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Claude Code\"' -e 'end run' \"$m\"; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Finished responding\" with title \"Claude Code\"' 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git *",
      "gh *",
      "vercel *",
      "npm *",
      "npx *",
      "pnpm *",
      "yarn *",
      "docker *",
      "go *",
      "gradle *",
      "./gradlew *",
      "mvn *",
      "./mvnw *",
      "uv *",
      "dotnet *",
      "xcodebuild *",
      "xcrun *",
      "swift *"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark"
}
